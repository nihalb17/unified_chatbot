# Phase 2 — Factsheet RAG API (FastAPI + Chroma + local embeddings)
# Build: docker build -f docker/Dockerfile.phase2 -t capstone-phase2 .
# Attach persistent disk at /app/backend/phase2_factsheet_rag/chroma_db on Render if you need indexes to survive redeploys.

FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend/phase2_factsheet_rag/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend/phase2_factsheet_rag /app/backend/phase2_factsheet_rag

WORKDIR /app/backend/phase2_factsheet_rag

ENV PYTHONUNBUFFERED=1
# Optional: pin Hugging Face cache inside the image layer (first embed still downloads weights).
ENV HF_HOME=/app/.cache/huggingface
RUN mkdir -p "$HF_HOME"

CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT:-8001}"]
