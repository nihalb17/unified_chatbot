# Phase 3 — Orchestrator API (FastAPI + LangGraph + voice WebSocket)
# Build: docker build -f docker/Dockerfile.phase3 -t capstone-phase3 .

FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY backend/phase3_orchestrator/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend/phase3_orchestrator /app/backend/phase3_orchestrator
COPY backend/data /app/backend/data

WORKDIR /app/backend/phase3_orchestrator

ENV PYTHONUNBUFFERED=1

CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT:-8002}"]
